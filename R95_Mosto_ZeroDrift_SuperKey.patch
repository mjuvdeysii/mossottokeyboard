+/// 九宫格/数字键盘专属分类符号面板：左列分类、中区网格、右列四行与九宫格严格对齐（⌫ / 空格 / 返回 / 发送）。
+final class SymbolPanelView: UIView, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+    var onSymbol: ((String) -> Void)?
+    var onDelete: (() -> Void)?
+    var onSpace: (() -> Void)?
+    var onReturn: (() -> Void)?
